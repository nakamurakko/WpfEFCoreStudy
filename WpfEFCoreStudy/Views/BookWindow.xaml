<Window x:Class="WpfEFCoreStudy.Views.BookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfEFCoreStudy.Views"
        xmlns:viewModels="clr-namespace:WpfEFCoreStudy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:BookWindowViewModel}"
        Title="{Binding Title}"
        Height="200"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Readonly Style。編集時は非表示。 -->
        <Style x:Key="ReadonlyStyle"
               TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadonly}"
                             Value="false">
                    <Setter Property="Visibility"
                            Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Not Readonly Style。 ReadOnly 時は非表示。 -->
        <Style x:Key="NotReadonlyStyle"
               TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadonly}"
                             Value="true">
                    <Setter Property="Visibility"
                            Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 追加時 Style -->
        <Style x:Key="DisplayModeAddStyle"
               TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode}"
                             Value="Edit">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 編集時 Style -->
        <Style x:Key="DisplayModeEditStyle"
               TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode}"
                             Value="Add">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <StackPanel>
        <Grid ColumnDefinitions="auto, *"
              RowDefinitions="auto, auto">

            <Label Grid.Column="0"
                   Grid.Row="0"
                   Content="タイトル"
                   VerticalContentAlignment="Center" />
            <TextBox Grid.Column="1"
                     Grid.Row="0"
                     IsReadOnly="{Binding IsReadonly}"
                     Text="{Binding Book.Title}"
                     VerticalContentAlignment="Center" />

            <Label Grid.Column="0"
                   Grid.Row="1"
                   Content="著者"
                   VerticalContentAlignment="Center" />
            <Grid Grid.Column="1"
                  Grid.Row="1"
                  Style="{StaticResource ReadonlyStyle}">
                <Label Content="{Binding Book.Author.AuthorName}"
                       VerticalContentAlignment="Center" />
            </Grid>
            <Grid Grid.Column="1"
                  Grid.Row="1"
                  Style="{StaticResource NotReadonlyStyle}">
                <ComboBox DisplayMemberPath="AuthorName"
                          ItemsSource="{Binding Authors}"
                          HorizontalContentAlignment="Stretch"
                          SelectedItem="{Binding Book.Author}" />
            </Grid>
        </Grid>

        <Grid Style="{StaticResource NotReadonlyStyle}">
            <StackPanel HorizontalAlignment="Center">
                <Grid Style="{StaticResource DisplayModeAddStyle}">
                    <Button Command="{Binding AddBookCommand}"
                            Content="追加" />
                </Grid>
                <Grid Style="{StaticResource DisplayModeEditStyle}">
                    <Button Command="{Binding UpdateBookCommand}"
                            Content="更新" />
                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>

</Window>
