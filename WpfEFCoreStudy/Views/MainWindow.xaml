<Window x:Class="WpfEFCoreStudy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfEFCoreStudy.Views"
        xmlns:viewModels="clr-namespace:WpfEFCoreStudy.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}">

    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="RightSpacingStyle"
               TargetType="Grid">
            <Style.Setters>
                <Setter Property="Margin"
                        Value="0, 0, 5, 0" />
            </Style.Setters>
        </Style>

        <Style x:Key="SeparatorStyle"
               TargetType="Border">
            <Style.Setters>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                <Setter Property="BorderThickness"
                        Value="0.5" />
                <Setter Property="Margin"
                        Value="5" />
            </Style.Setters>
        </Style>
    </Window.Resources>

    <Grid RowDefinitions="auto, *">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, auto, auto, auto, auto">

            <Grid Grid.Column="0"
                  ColumnDefinitions="auto, *, auto, *">

                <Label Grid.Column="0"
                       Content="タイトル"
                       VerticalContentAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchTitle}"
                         VerticalContentAlignment="Center" />
                <Label Grid.Column="2"
                       Content="著者"
                       VerticalContentAlignment="Center" />
                <TextBox Grid.Column="3"
                         Text="{Binding SearchAuthorName}"
                         VerticalContentAlignment="Center" />
            </Grid>

            <Button Grid.Column="1"
                    Command="{Binding SearchBooksCommand}"
                    Content="検索" />
            <Button Grid.Column="2"
                    Command="{Binding ClearSearchResultCommand}"
                    Content="検索結果をクリア" />

            <Button Grid.Column="3"
                    Command="{Binding AddBookCommand}"
                    Content="本を追加" />

            <Button Grid.Column="4"
                    Command="{Binding AddAuthorCommand}"
                    Content="著者を追加" />

        </Grid>

        <ListView Grid.Row="1"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding Books}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray"
                            BorderThickness="0.5"
                            CornerRadius="5"
                            Padding="5">
                        <Grid ColumnDefinitions="auto, *, auto, auto, auto"
                              RowDefinitions="auto, auto, auto, auto, auto"
                              Margin="2">

                            <Grid Grid.Column="0"
                                  Grid.Row="0"
                                  Style="{StaticResource RightSpacingStyle}">
                                <Label Content="タイトル"
                                       VerticalAlignment="Center" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   Content="{Binding Title}" />

                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Grid.Row="1"
                                    Style="{StaticResource SeparatorStyle}" />

                            <Grid Grid.Column="0"
                                  Grid.Row="2">
                                <Label Content="著者"
                                       VerticalAlignment="Center" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Grid.Row="2"
                                   Content="{Binding Author.AuthorName}" />

                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Grid.Row="3"
                                    Style="{StaticResource SeparatorStyle}" />

                            <Grid Grid.Column="0"
                                  Grid.Row="4"
                                  Style="{StaticResource RightSpacingStyle}">
                                <Label Content="書評"
                                       VerticalAlignment="Center" />
                            </Grid>
                            <Label Grid.Column="1"
                                   Grid.Row="4"
                                   Content="{Binding BookReview.BookReviewContent}" />


                            <Grid Grid.Column="2"
                                  Grid.Row="0"
                                  Grid.RowSpan="5"
                                  Style="{StaticResource RightSpacingStyle}">
                                <Button Command="{Binding DataContext.ShowBookCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}"
                                        Content="表示" />
                            </Grid>

                            <Grid Grid.Column="3"
                                  Grid.Row="0"
                                  Grid.RowSpan="5"
                                  Style="{StaticResource RightSpacingStyle}">
                                <Button Command="{Binding DataContext.EditBookCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}"
                                        Content="編集" />
                            </Grid>

                            <Button Grid.Column="4"
                                    Grid.Row="0"
                                    Grid.RowSpan="5"
                                    Command="{Binding DataContext.EditBookReviewCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                    CommandParameter="{Binding}"
                                    Content="書評" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>

</Window>
